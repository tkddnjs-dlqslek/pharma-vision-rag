# ─── Anthropic (Claude Sonnet 4.7 Vision + Haiku judge) ───
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# ─── HuggingFace (Nemotron ColEmbed V2, BGE-M3, ZeRank2 downloads) ───
HF_TOKEN=hf_xxxxxxxxxxxx

# ─── Qdrant (local docker-compose uses port 6335 to avoid conflict with other Qdrant instances) ───
QDRANT_URL=http://localhost:6335
QDRANT_API_KEY=
# Qdrant Cloud free tier (retriever/text_cloud.py, scripts/29). Both set -> dense text search uses the cloud collection
QDRANT_CLOUD_URL=
QDRANT_CLOUD_API_KEY=

# ─── Langfuse (cloud by default — create project at https://cloud.langfuse.com) ───
# Note: LANGFUSE_HOST was renamed to LANGFUSE_BASE_URL in recent SDK versions.
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxx
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com    # US region; use https://cloud.langfuse.com for EU

# ─── Colab Nemotron tunnel (set when running notebook with ngrok/cloudflared) ───
# Filled in at query time; leave blank until notebook prints a URL.
COLAB_EMBEDDING_URL=

# ─── RunPod Serverless query encoder (serverless/README.md). Both set -> MCP search_pages encodes remotely ───
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# Or the self-hosted services/encoders container (Nemotron + BGE-M3 + reranker over HTTP, services/deploy.md). Both set ->
# search_pages and the dense search_text use it. Or Modal (serverless/modal_app.py): no keys here, `modal token new`.
ENCODER_URL=http://localhost:7860
ENCODER_TOKEN=
# auto picks RunPod keys > ENCODER_URL > Modal token. VISION_ENCODER=auto|runpod|http|modal|none
VISION_ENCODER=auto

# ─── Remote MCP server: services/mcp via docker compose (or Modal, serverless/modal_mcp.py). Same MCP_TOKEN in the container ───
MCP_URL=http://localhost:8000/mcp
MCP_TOKEN=
# Public https origin of the MCP container (Cloudflare tunnel hostname); OAuth redirects and metadata use it
MCP_PUBLIC_URL=https://mcp.example.com
# Login for the claude.ai / Claude Desktop connector (OAuth form served by the MCP app)
MCP_USER=pharma
MCP_PASSWORD=
# HF dataset repo with the corpus files (scripts/30_upload_corpus_data.py); the MCP container downloads it at start
DATA_REPO=sangwongim922/pharma-corpus-data

# ─── Optional: Qwen3-VL (open VLM comparator via HF inference or local) ───
# QWEN_VL_ENDPOINT=https://api-inference.huggingface.co/models/Qwen/Qwen3-VL-8B

# ─── Self-hosted Langfuse (only if uncommenting docker-compose block) ───
# LANGFUSE_DB_PASSWORD=change-me
# LANGFUSE_NEXTAUTH_SECRET=run `openssl rand -hex 32`
# LANGFUSE_SALT=run `openssl rand -hex 32`

# ─── Self-hosted HTTPS front (docker-compose.yml caddy service): hostname that resolves to the box's public IP ───
# On AWS scripts/31_aws_deploy.py writes <public-ip>.sslip.io here (plus AWS_INSTANCE_ID, AWS_PUBLIC_IP, MCP_PUBLIC_URL, MCP_URL)
PUBLIC_HOST=

# ─── AWS one-month experiment (scripts/31_aws_deploy.py): IAM user with AmazonEC2FullAccess ───
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-2
